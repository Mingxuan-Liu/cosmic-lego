{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstroCompose exoplanet scene v0.1",
  "description": "Independent circular two-body systems, observers, and linked views. Units appear in field names. Physical coupling constraints are checked separately.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 40
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "starMassSolar": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 3
          },
          "starRadiusSolar": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 5
          },
          "planetMassJupiter": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "planetRadiusJupiter": {
            "type": "number",
            "minimum": 0,
            "maximum": 2.5
          },
          "periodDays": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 365
          }
        },
        "required": [
          "id",
          "label",
          "starMassSolar",
          "starRadiusSolar",
          "planetMassJupiter",
          "planetRadiusJupiter",
          "periodDays"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "observers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 40
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "inclinationDeg": {
            "type": "number",
            "minimum": 0,
            "maximum": 90
          }
        },
        "required": [
          "id",
          "label",
          "inclinationDeg"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 8
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 40
          },
          "systemId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 40
          },
          "observerId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "id",
          "systemId",
          "observerId"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "presentation": {
      "type": "object",
      "properties": {
        "orbitSeconds": {
          "type": "number",
          "minimum": 4,
          "maximum": 120
        },
        "planetDisplayScale": {
          "type": "number",
          "minimum": 1,
          "maximum": 12
        }
      },
      "required": [
        "orbitSeconds",
        "planetDisplayScale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "systems",
    "observers",
    "views",
    "presentation"
  ],
  "additionalProperties": false
}
